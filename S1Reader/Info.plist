<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The generated Info.plist keeps everything else; this file only adds the
	     keys a build setting cannot express. `s1reader://` is what intents and
	     Siri hand back to the app (see AppDeepLink). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>com.faye.S1Reader</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>s1reader</string>
			</array>
		</dict>
	</array>
	<!-- The reading Live Activity is rendered by the S1ReaderWidgets extension;
	     the app is the side that asks ActivityKit to start one. -->
	<key>NSSupportsLiveActivities</key>
	<true/>
</dict>
</plist>
